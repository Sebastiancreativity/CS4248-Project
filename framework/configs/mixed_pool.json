{
  "name": "mixed_pool",
  "dev": [
    "dev_wmt",
    "dev_alma"
  ],
  "systems": {
    "qwen2.5-1.5b": "results/candidates/qwen2.5-1.5b.{dev}.jsonl",
    "qwen2.5-3b": "results/candidates/qwen2.5-3b.{dev}.jsonl",
    "opus-mt-zh-en": "results/candidates/opus-mt-zh-en.{dev}.txt",
    "nllb-600m": "results/candidates/nllb-600m.{dev}.txt"
  },
  "scorers": {
    "nllb_fwd": {
      "type": "likelihood",
      "name": "nllb1.3b.fwd",
      "model": "facebook/nllb-200-distilled-1.3B",
      "src_lang": "zho_Hans",
      "tgt_lang": "eng_Latn",
      "batch_size": 16
    },
    "opus_fwd": {
      "type": "likelihood",
      "name": "opusmt.zh-en.fwd",
      "model": "Helsinki-NLP/opus-mt-zh-en",
      "batch_size": 32
    },
    "opus_rev": {
      "type": "likelihood",
      "name": "opusmt.en-zh.rev",
      "model": "Helsinki-NLP/opus-mt-en-zh",
      "reverse": true,
      "prefix": ">>cmn_Hans<< ",
      "batch_size": 32
    },
    "opus_cov": {
      "type": "coverage",
      "name": "opusmt.zh-en.cov.L-2",
      "model": "Helsinki-NLP/opus-mt-zh-en",
      "layer": -2,
      "batch_size": 16
    }
  },
  "features": {
    "fwd": "nllb_fwd",
    "rev": "opus_rev"
  },
  "methods": [
    {
      "name": "greedy",
      "type": "first"
    },
    {
      "name": "qwen2.5-3b_only",
